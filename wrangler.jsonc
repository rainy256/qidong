{
  "name": "qidong",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "qidong-db",
    "migrations_dir": "worker/migrations"
    // Add database_id here after creating the production D1 database.
  }],
  "vars": { "ROOM_TTL_DAYS": "30" },
  "triggers": { "crons": ["0 */6 * * *"] },
  "observability": { "enabled": true }
}
